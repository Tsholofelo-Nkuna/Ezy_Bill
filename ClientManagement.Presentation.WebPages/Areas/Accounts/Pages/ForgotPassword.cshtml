@page
@using Core.Presentation.ViewComponents.Components;
@model Core.Presentation.ViewComponents.Areas.Accounts.Pages.ForgotPasswordModel
@{
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


<div class="d-flex flex-column w-100 align-items-center">
    @if(!string.IsNullOrWhiteSpace(this.Model.Message)){
        <div class="text-@this.Model.MessageColor">@this.Model.Message</div>
    }
    <form class="card col-xs-11 col-sm-10 col-md-8 col-lg-6 d-flex flex-column" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="card-body">
            <div>
                <label asp-for="@this.Model.ForgotPasswordViewModel.Email" class="form-label"></label>
                <input readonly name="@nameof(Model.ForgotPasswordViewModel.Email)" asp-for="@this.Model.ForgotPasswordViewModel.Email" class="form-control" />
            </div>
            <div>
                <label asp-for="@this.Model.ForgotPasswordViewModel.Password" class="form-label"></label>
                <input name="@nameof(Model.ForgotPasswordViewModel.Password)" asp-for="@this.Model.ForgotPasswordViewModel.Password" class="form-control" />
            </div>
            <div>
                <label asp-for="@this.Model.ForgotPasswordViewModel.ConfirmPassword" class="form-label"></label>
                <input name="@nameof(Model.ForgotPasswordViewModel.ConfirmPassword)" asp-for="@this.Model.ForgotPasswordViewModel.ConfirmPassword" class="form-control" />
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-primary me-1" href="@ClientManagement.Utils.Constants.LoginPathConstants.Login"> <i class="bi bi-arrow-left"></i> Login</a>
            <button class="btn btn-primary">Submit</button>
        </div>
    </form>
    <div class="d-inline-flex mt-1">
        <component type="typeof(CopyRightComponent)" render-mode="ServerPrerendered" />
    </div>
</div>

