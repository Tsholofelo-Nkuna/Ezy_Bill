@page
@using Core.Presentation.ViewComponents.Components
@using ClientManagement.Utils.Constants
@model Core.Presentation.ViewComponents.Areas.Accounts.Pages.ResetPasswordLinkModel
@{
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<div class="d-flex flex-column w-100 align-items-center">
    <h3>Reset password link will be sent to your email</h3>
    <p>@this.Model.Message</p>
    <form class="card col-xs-11 col-sm-10 col-md-8 col-lg-6 col-xl-4" method="post">
        <div class="card-body">
            <label asp-for="@Model.Email" class="form-label"></label>
            <input class="form-control" name="@nameof(Model.Email)" asp-for="@Model.Email" />
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-primary m-2" href="@LoginPathConstants.Login">
                <i class="bi bi-arrow-left"></i>
                <span>Login</span>
            </a>
            <button class="btn btn-primary">Submit</button>
        </div>
    </form>
    <div class="my-1">
        <component type="typeof(CopyRightComponent)" render-mode="ServerPrerendered"></component>
    </div>
</div>
