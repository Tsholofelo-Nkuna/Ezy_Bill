@using ClientManagement.Presentation.Models.DataTransferObjects
@using Core.Presentation.ViewComponents.Components.Templates;
@inherits GenericComponentBase<InvoiceTemplateViewModel, InvoiceDto>
<div style="display:flex; justify-content:space-between;padding: 0.5rem 1rem;">
    <div>
        <h3>
            From:
        </h3>
        <div>
            <LabelValueTemplate>
                <Value>@CurrentUserDetails.UserName</Value>
            </LabelValueTemplate>
        </div>
        <div>
            <LabelValueTemplate>
                <Value>@CurrentUserDetails.PhoneNumber</Value>
            </LabelValueTemplate>
        </div>
    </div>
    <div>
        <h3>
            To:
        </h3>
        <div>
            <LabelValueTemplate>
             <Value>@(this.Invoice?.Client?.CompanyName)</Value>
            </LabelValueTemplate>
        </div>
        <div>
            <LabelValueTemplate>
                <Value>@(this.Invoice?.Client?.Address)</Value>
            </LabelValueTemplate>
        </div>
    </div>
</div>
<div style="display:flex;padding: 0.5rem 1rem;flex-direction:column">
    <h3>
        Billed Items
    </h3>
    <table style="width:100%">
        <thead>
            <tr>
                <th>Description</th>
                <th>Quantity</th>
                <th>Price Per Item</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in (this.Invoice?.InvoiceProducts ?? Enumerable.Empty<InvoiceProductDto>()))
            {
                <tr>
                    <td style="text-align:center">@(string.Join(" | ",item.ProductName, item.ProductDescription))</td>
                    <td style="text-align:center">@item.Quantity</td>
                    <td style="text-align:center">@($"{item.ProductPrice:C}")</td>
                    <td style="text-align:center">@($"{item.TotalCost:C}")</td>
                </tr>
            }
            @if (!(this.Invoice?.InvoiceProducts ?? Enumerable.Empty<InvoiceProductDto>()).Any())
            {
                <tr><td style="text-align:center;">No Items</td></tr>
            }
        </tbody>
    </table>
</div>
<div style="display:flex;padding: 0.5rem 1rem;flex-direction:row-reverse;margin-top:0.5rem;">
   <div style="display:flex;flex-direction:column">
        <div>
            <div style="display:grid;grid-template-columns: auto auto;column-gap:0.5rem;">
                <label style="color:dimgray;font-weight:bold;">
                    Total Amount:
                </label>
                <span>
                    @($"{(this.Invoice?.Amount ?? 0):C}")
                </span>
            </div>
        </div>
        <div>
            <div style="display:grid;grid-template-columns: auto auto;column-gap:0.5rem;">
                <label style="color:dimgray;font-weight:bold;">
                    Outstanding Amount:
                </label>
                <span>
                    @($"{(this.Invoice?.OutstandingAmount ?? 0):C}")
                </span>
            </div>
        </div>
        <div>
            <div style="display:grid;grid-template-columns: auto auto;column-gap:0.5rem;">
                <label style="color:dimgray;font-weight:bold;">
                    Paid Amount:
                </label>
                <span>
                    @($"{(this.Invoice?.PaidAmount ?? 0):C}")
                </span>
            </div>
        </div>
   </div>

</div>