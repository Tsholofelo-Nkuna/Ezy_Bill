@using Core.Presentation.ViewComponents.Components.Templates
@using Microsoft.Extensions.AI
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar flex-column border-end">
        <div class="d-flex justify-content-between border-bottom border-2 border-primary m-0 py-0 px-2 mb-3 pt-2" style="height:3.5rem">
            <div class="navbar-brand">
                <span class="badge bg-primary">I</span>zyBill
            </div>
            <div>
                <i id="left-menu-button" @onclick="() => {ViewModel.ShowSideMenuItems = !ViewModel.ShowSideMenuItems;}" style="cursor:pointer" class="bi bi-list d-md-none"></i>
            </div>
        </div>
        <nav id="left-menu-items" class="nav nav-pills flex-column @(!ViewModel.ShowSideMenuItems ? "d-none":"") d-md-flex">
            <a href="/" class="nav-link mx-3 active"><i class="bi bi-house me-1"></i> Home</a>
            <a href="/Clients" class="nav-link mx-3"><i class="bi bi-people me-1"></i>Clients</a>
            <a href="/Products" class="nav-link mx-3"><i class="bi bi-cart4 me-1"></i>Products/Services</a>
            <a href="/Invoices" class="nav-link mx-3"><i class="bi bi-receipt-cutoff me-1"></i>Invoices</a>
            <a href="/Knowledge-base" class="nav-link mx-3"><i class="bi bi-database me-1"></i>Knowledge base</a>
        </nav>
       
    </div>
    <main>
        <div class="top-row px-4 bg-primary-subtle">
            <ButtonTemplate 
                CssClass="btn btn-outline-primary"
                ToolTip="Help"
                OnClick="() => { AssistantLaunced = true;}">
                <Icon>
                    <i class="bi bi-robot"></i>
                </Icon>
            </ButtonTemplate>
            <ModalComponent TRecordType="BaseDto"
                            @bind-Show="AssistantLaunced"
                            Width="512px">
                <Body>
                    @if (BookkeeperAgent?.ChatHistory?.Any()??false)
                    {
                        <div id="chatPanel" class="border border-1 border-primary my-2 p-3" style="border-radius:8px;height:auto;overflow-y:auto;max-height:256px;overflow-x:hidden;word-wrap:break-word;">
                            @foreach (var message in BookkeeperAgent.ChatHistory)
                            {
                                <div class="my-2">
                                    <span>@(message.Role == Microsoft.Extensions.AI.ChatRole.User ? "You:" : "Assistant:")</span>
                                    <div class="rounded-2 p-3 border border-2 @(message.Role == Microsoft.Extensions.AI.ChatRole.Assistant ? "border-primary" : "border-primary-subtle")">
                                       @foreach(var x in message.Contents.OfType<TextContent>()){
                                           if(x is TextContent textData)
                                            {
                                                <span>@textData</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @foreach(var chatMessage in BookkeeperAgent?.ChatHistory ?? [])
                    {
                        @foreach(var imageItem in chatMessage.Contents.OfType<DataContent>())
                        {
                            <div style="background-image:url('@imageItem.Uri'); background-size:cover;width:64px; height:64px;" class="d-inline-block rounded-circle border border-2 border-primary-subtle m-2"></div>

                        }
                       
                    }
                    @if (!string.IsNullOrWhiteSpace(ImagePresentedToAgent.dataUrl))
                    {
                       <div style="background-image:url('@ImagePresentedToAgent.dataUrl'); background-size:cover;width:64px; height:64px;" class="rounded-2 border border-2 border-primary-subtle m-2"></div>
                    }
                    <div style="display:grid; grid-template-columns: 1fr auto;" class="mb-2">
                        <input class="form-control mx-2" @bind-value="AgentInstructions" placeholder="Enter instructions" />
                        <ButtonTemplate 
                            CssClass="btn btn-outline-primary"
                            IsLoading="AgentIsBusy"
                            OnClick="OnSendAgentInstructions">
                            <Icon>
                                <em class="bi bi-send"></em>
                            </Icon>
                        </ButtonTemplate>
                    </div> 
                    <div class="container">
                       <InputFile @key="KeyForImagePresentedToAgent" OnChange="OnFilePresentedToAgent" class="form-control"></InputFile>
                    </div>
                </Body>
                <Footer>
                    <div class="container">
                        <ButtonTemplate CssClass="btn btn-primary" Text="Clear"
                        OnClick="OnClearAgentConversation">
                        </ButtonTemplate>
                    </div>
                </Footer>
            </ModalComponent>
            <div class="d-flex flex-row-reverse">
                <span class="position-relative" @onclick="() =>{ShowUserProfileModal = true;}" style="cursor:pointer">

                    <a class="bg-body-tertiary rounded-circle d-inline-flex justify-content-center align-items-center position-relative"
                    style="width:1.5rem;height:1.5rem;"
                    >
                        <i class="bi bi-person"></i>

                    </a>
                    <span class="text-primary text-decoration-underline">
                        @Username
                    </span>
                    <ModalComponent ViewModel="ViewModel.UserProfileModalViewModel"
                    @bind-Show="ShowUserProfileModal"
                    CssClassList="@(["position-absolute top-50 end-0"])">
                        <Body>
                            <div class="list-group">
                               @foreach(var item in this.UserProfileModalListItems){
                                    <div class="list-group-item" @onclick:stopPropagation="true" @onclick="() => OnUserProfileModalItemClicked(item)">
                                        <a class="text-decoration-none" >
                                            <i class="@item.IconClass me-1"></i><span>@item.Text</span>
                                        </a>
                                    </div>
                               }
                               
                            </div>
                        </Body>
                        <Footer>
                            <div class="d-flex flex-column w-100 align-items-center">
                                <a href="/Accounts/Logout" title="Signout">
                                    <i class="bi bi-box-arrow-right me-1"></i><span>Signout</span>
                                </a>
                            </div>
                        </Footer>
                    </ModalComponent>
                </span>
               
            </div>
          
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<script>
  
    [...document.querySelectorAll(".sidebar .nav-link")].forEach((e,index, currentCollection) => {
       e.addEventListener("click",eventPayload => {
           eventPayload.currentTarget.classList.add("active");
           currentCollection.filter(x => x!==e).forEach(otherE => otherE.classList.remove("active"));
       })
    });
     function getWindowDimensions(){
            return {
                innerWidth,
                innerHeight
            }
        }

     (function(){
        
        let leftMenuItemsContainer = document.querySelector("#left-menu-items");
        [...document.querySelectorAll("#left-menu-items > a")]
        .forEach( ele => {
          ele.addEventListener("click", function(){
           
            if(innerWidth < 768){
                leftMenuItemsContainer.classList.add("d-none");
            }
          })
        });
        
       
       
     })();
    
</script>
