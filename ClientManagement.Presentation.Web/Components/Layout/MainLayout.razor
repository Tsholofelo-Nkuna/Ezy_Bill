@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar border-end border-secondary-subtle">
        <div class="border-bottom border-2 border-primary align-content-center px-3">
            <div class="navbar-brand d-flex justify-content-between">
                <div>
                    <span class="badge bg-primary">I</span>zyBill
                </div>
                <i id="left-menu-button" @onclick="() => {ViewModel.ShowSideMenuItems = !ViewModel.ShowSideMenuItems;}" style="cursor:pointer" class="bi bi-list d-md-none"></i>
            </div>
        </div>
        <div class="sidebar-content @(!ViewModel.ShowSideMenuItems ? "d-none":"") d-md-grid py-3">
            <nav id="left-menu-items" class="nav nav-pills flex-column">
                <a href="/" class="nav-link mx-3 active"><i class="bi bi-house me-1"></i> Home</a>
                <a href="/Clients" class="nav-link mx-3"><i class="bi bi-people me-1"></i>Clients</a>
                <a href="/Products" class="nav-link mx-3"><i class="bi bi-cart4 me-1"></i>Products/Services</a>
                <a href="/Invoices" class="nav-link mx-3"><i class="bi bi-receipt-cutoff me-1"></i>Invoices</a>
            </nav>

            <nav class="nav flex-column-reverse">
               @*  <a href="/Invoices" class="nav-link mx-3"><i class="bi bi-gear me-1"></i>Settings</a> *@
                <a href="/Invoices" class="nav-link mx-3"><i class="bi bi-chat me-1"></i>Support</a>
            </nav>
        </div>
       
    </div>
    <main>
        <div class="top-row px-4 bg-primary-subtle">
            <div class="d-flex flex-row-reverse">
                <span class="position-relative" @onclick="() =>{ShowUserProfileModal = true;}" style="cursor:pointer">
                    <a class="bg-body-tertiary rounded-circle d-inline-flex justify-content-center align-items-center position-relative"
                    style="width:1.5rem;height:1.5rem;"
                    >
                        <i class="bi bi-person"></i>

                    </a>
                    <span class="text-primary text-decoration-underline">
                        @Username
                    </span>
                    <ModalComponent ViewModel="ViewModel.UserProfileModalViewModel"
                    @bind-Show="ShowUserProfileModal"
                    CssClassList="@(["position-absolute top-50 end-0"])">
                        <Body>
                            <div class="list-group">
                               @foreach(var item in this.UserProfileModalListItems){
                                    <div class="list-group-item" @onclick:stopPropagation="true" @onclick="() => OnUserProfileModalItemClicked(item)">
                                        <a class="text-decoration-none" >
                                            <i class="@item.IconClass me-1"></i><span>@item.Text</span>
                                        </a>
                                    </div>
                               }
                               
                            </div>
                        </Body>
                        <Footer>
                            <div class="d-flex flex-column w-100 align-items-center">
                                <a href="/Accounts/Logout" title="Signout">
                                    <i class="bi bi-box-arrow-right me-1"></i><span>Signout</span>
                                </a>
                            </div>
                        </Footer>
                    </ModalComponent>
                </span>
            </div>

        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<script>
  
    [...document.querySelectorAll(".sidebar .nav-link")].forEach((e,index, currentCollection) => {
       e.addEventListener("click",eventPayload => {
           eventPayload.currentTarget.classList.add("active");
           currentCollection.filter(x => x!==e).forEach(otherE => otherE.classList.remove("active"));
       })
    });
     function getWindowDimensions(){
            return {
                innerWidth,
                innerHeight
            }
        }

     (function(){
        
        let leftMenuItemsContainer = document.querySelector("#left-menu-items");
        [...document.querySelectorAll("#left-menu-items > a")]
        .forEach( ele => {
          ele.addEventListener("click", function(){
           
            if(innerWidth < 768){
                leftMenuItemsContainer.classList.add("d-none");
            }
          })
        });
        
       
       
     })();
    
</script>
