@using ClientManagement.Presentation.Models.DataTransferObjects
@using Core.Presentation.ViewComponents.Components.Templates
@using Microsoft.AspNetCore.Authorization
@page "/Invoices/Details/{id:guid}"
@attribute [Authorize]
@inherits GenericComponentBase<InvoiceDetailsViewModel, InvoiceDto>
@{
    var contactPerson = OverviewModelState?.Client?.ContactPerson?.FirstOrDefault(contact => contact.IsPrimaryContact);
    var contactEmail = contactPerson?.Email ?? string.Empty;
    var contactPhone = contactPerson?.Phone ?? string.Empty;
    var contactName = contactPerson?.Name ?? string.Empty;
    var clientDetails = OverviewModelState?.Client;
}
<PageTitle>Invoice - Details</PageTitle>
<PageComponent ShowBackButton="true">
    <TopControls>
        @if (!string.IsNullOrWhiteSpace(this.InvoicePdfBase64))
        {
          <a class="btn btn-link text-success" href="@this.InvoicePdfBase64" download="invoice">Open Invoice</a>
        }
       
        <ButtonTemplate 
            CssClass="btn btn-outline-primary"
            OnClick="OnPrintInvoice"
            ToolTip="Download Invoice"
            IsLoading ="PrintBusy"
        >
          <Icon>
                <i class="bi bi-download"></i>
          </Icon>
        </ButtonTemplate>
       
    </TopControls>
    <Body>
        <OverviewComponent ViewModel="ViewModel.OverviewModel">
            <OverviewSection>
                @if(context == "ClientDetails"){
                    <div>
                        <OverviewLabelComponent Text="Company Name"></OverviewLabelComponent>: @this.OverviewModelState?.Client?.CompanyName
                    </div>
                    <div>
                      
                        <OverviewLabelComponent Text="Landline number"></OverviewLabelComponent>: @(clientDetails?.LandlineNumber ?? string.Empty)
                   </div>
                    <div>
                        <OverviewLabelComponent Text="Trading As"></OverviewLabelComponent>: @(clientDetails?.TradingAs ?? string.Empty)
                    </div>
               }
                else if (context == "InvoiceDetails")
                {
                    <div>
                        <OverviewLabelComponent Text="Amount"></OverviewLabelComponent>: @($"{Invoice?.Amount??0:C}")
                    </div>
                    <div>

                        <OverviewLabelComponent Text="Paid Amount"></OverviewLabelComponent>: @($"{Invoice?.PaidAmount ?? 0:C}")
                    </div>
                    <div>
                        <OverviewLabelComponent Text="Outstanding Amount"></OverviewLabelComponent>: @($"{Invoice?.OutstandingAmount ?? 0:C}")
                    </div>
                   
               }
               else if(context == "ClientContacts"){
                    <div>
                        <OverviewLabelComponent Text="Name"></OverviewLabelComponent>: @contactName
                    </div>
                    <div>

                        <OverviewLabelComponent Text="Email"></OverviewLabelComponent>: @contactEmail
                    </div>
                    <div>
                        <OverviewLabelComponent Text="Phone"></OverviewLabelComponent>: @contactPhone
                    </div>
                    
               }
           </OverviewSection>
        </OverviewComponent>
        <TabsComponent 
            ViewModel="ViewModel.TabsViewModel"
            @bind-Tab="InvoiceDetailsTab">
            <TabItem> 
                @if(context.Name.Equals("products", StringComparison.OrdinalIgnoreCase)){

                    <TableComponent @ref="InvoiceProductTable"
                        ViewModel="ViewModel.InvoiceProductsTableViewModel"
                        OnSaveUpdatesClick="OnSaveInvoiceProduct"
                        @bind-EditIndex="InvoiceProductsTableEditIndex"
                        OnDeleteClick="OnDeleteInvoiceProduct"
                        OnNewClick="OnInvoiceProductTableNewClick"
                    >
                    </TableComponent>
                    <div class="container">
                      <div class="row flex-row-reverse">
                          <div class="col-3">
                             <LabelValueTemplate>
                                 <Label>
                                     <span class="fw-bold">Total:</span>
                                 </Label>
                                 <Value>
                                     <div>@($"{InvoicedProductsTotalAmount:C}")</div>
                                 </Value>
                             </LabelValueTemplate>
                          </div>
                      </div>
                    </div>
                }
                else if(context.Name.Equals("payments",StringComparison.OrdinalIgnoreCase)){
                   <TableComponent @ref="InvoicePaymentTable"
                       ViewModel="ViewModel.InvoicePaymentsTableViewModel"
                       OnDeleteClicked="OnDeleteInvoicePayment"
                       OnNewClicked="OnNewInvoicePaymentClicked"
                       OnSaveUpdatesClick="OnEditInvoicePaymentSaveClick"
                       @bind-EditIndex="InvoicePaymentsTableEditIndex">
                       
                   </TableComponent>
                }
            </TabItem>
        </TabsComponent>
        <ModalComponent ViewModel="ViewModel.InvoicePaymentModalViewModel">
            <Body>
                <FormComponent 
                    ViewModel="ViewModel.NewInvoicePaymentFormViewModel"
                    OnFormSubmitClicked="OnNewInvoicePaymentSave"
                    SubmitBusy ="InvoicePaymentInProgress">
                </FormComponent>
            </Body>
        </ModalComponent>
        <ModalComponent
            ViewModel="ViewModel.InvoiceProductViewModalModel">
            <Body>
                <FormComponent ViewModel="ViewModel.NewInvoiceProductFormViewModel"
                               OnFormSubmitClicked="OnNewInvoiceProductSave"
                               SubmitBusy="InvoiceProductCreationInProgress">
                </FormComponent>
            </Body>
        </ModalComponent>
    </Body>
</PageComponent>