@page "/Knowledge-base"
@using Microsoft.AspNetCore.Authorization
@namespace ClientManagement.Presentation.Web.Components.Pages.Files
@attribute [Authorize]

<PageComponent>
      <Body>
        <FileUploadComponent Label="Upload Your Files"
                             AcceptedFileTypes=".pdf,.doc,.docx,.xlsx,.xls,.jpg,.jpeg,.png"
                             MaxFileSize="10485760"
                             AllowMultiple="true"
                             OnMultipleFilesSelected="HandleFilesSelected"
                             UploadedFiles="UploadedFiles"
                             CssClass="mt-4" />
        @if (UploadedFiles.Any())
        {
            <div class="mt-5">
                <h5>Uploaded Files Summary:</h5>
                <div class="alert alert-info">
                    <p>Total files uploaded: <strong>@UploadedFiles.Count</strong></p>
                    <p>Total size: <strong>@FormatTotalSize()</strong></p>
                </div>
            </div>
        }
      </Body>
</PageComponent>

