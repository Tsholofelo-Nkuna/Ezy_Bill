﻿
<!DOCTYPE html>
<html lang="en">
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Core.Presentation.ViewComponents/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

</head>

<body>
    <div style="display:grid; height:100vh;width:100vw;grid-template-columns: 256px 1fr;grid-template-rows: 1fr;">
        <nav class="nav nav-pills flex-column bg-primary-subtle p-3">
            <a class="nav-link active" href="/Admin"><i class="bi bi-people me-1"></i> User Profiles</a>
        </nav>
       <div class="d-flex flex-column w-100">
            <div class="position-sticky d-flex border-2 border-bottom border-primary bg-body-tertiary" style="height:3.5rem;"></div>
            <div class="container">@RenderBody()</div>
       </div> 
    </div>
</body>

</html>