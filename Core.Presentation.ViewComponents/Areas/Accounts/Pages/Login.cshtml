@page
@using Core.Presentation.ViewComponents.Components
@model Core.Presentation.ViewComponents.Areas.Accounts.Pages.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
}


<div style="display:grid;place-items:center;grid-template-columns: 1fr; width:100vw;height:100vh;">
    <div>
        <form class="card" style="width:512px;" method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="card-body">
                <div class="row">
                    <label asp-for="@Model.CredentialsDto.Username" class="col-form-label col-auto text-end"></label>
                    <input name="@nameof(Model.CredentialsDto.Username)" asp-for="@Model.CredentialsDto.Username" class="form-control col-auto text-start" type="email" />

                </div>
                <div class="row">
                    <label asp-for="@Model.CredentialsDto.Password" class="col-f col-auto text-end"></label>
                    <input name="@nameof(Model.CredentialsDto.Password)" asp-for="@Model.CredentialsDto.Password" class="form-control col-auto text-start" type="password" />
                </div>
                <div style="display:flex;column-gap:0.5rem;" class="my-2">
                    <a style="font-size:0.85rem" href="#">Forgot password</a>
                    <a style="font-size:0.85rem" href="#">Register</a>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary">Submit</button>
            </div>
        </form>
        <div style="font-size:0.833rem;" class="text-center my-2">&copy;2025 Tsholofelo Nkuna</div>
    </div>
</div>
