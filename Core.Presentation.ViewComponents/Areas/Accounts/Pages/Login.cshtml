@page
@using Core.Presentation.ViewComponents.Components
@model Core.Presentation.ViewComponents.Areas.Accounts.Pages.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
}

<div class="d-flex flex-column w-100 align-items-center">
    <form class="card col-xs-10 col-sm-8 col-md-6 col-lg-4" method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="card-body">
            <div class="row">
                <label asp-for="@Model.CredentialsDto.Username" class="col-form-label col-auto text-end"></label>
                <input placeholder="Email" name="@nameof(Model.CredentialsDto.Username)" asp-for="@Model.CredentialsDto.Username" class="form-control col-auto text-start" type="email" />

            </div>
            <div class="row">
                <label asp-for="@Model.CredentialsDto.Password" class="col-f col-auto text-end"></label>
                <input name="@nameof(Model.CredentialsDto.Password)" asp-for="@Model.CredentialsDto.Password" class="form-control col-auto text-start" type="password" />
            </div>
            <div style="display:flex;column-gap:0.5rem;" class="my-2">
                <a style="font-size:0.85rem" href="@Core.Utils.Constants.LoginPathConstants.ResetPassword">Forgot password</a>
                <a style="font-size:0.85rem" href="@Core.Utils.Constants.LoginPathConstants.Register">Register</a>
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-primary">Submit</button>
        </div>
    </form>
    <component type="typeof(CopyRightComponent)" render-mode="ServerPrerendered"></component>
</div>

