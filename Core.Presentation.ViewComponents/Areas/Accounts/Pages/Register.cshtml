@page
@model Core.Presentation.ViewComponents.Areas.Accounts.Pages.RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
}
@if(!string.IsNullOrWhiteSpace(Model.Message)){
    <div class="my-2 d-flex justify-content-center bg-white p-3 border-start border-3 @($"border-{Model.MessageColor} text-{Model.MessageColor}")">
        @Model.Message
    </div>
}
<div class="d-flex flex-column w-100 align-items-center">
    <div asp-validation-summary="All" class="text-danger"></div>
    <form method="post" class="card col-xs-10 col-sm-8 col-md-6 col-lg-4">
        <div class="card-header fs-5 text-primary">
            New Registration
        </div>
        <div class="card-body">
            <div class="row mb-1">
                <label class="form-label" asp-for="@Model.ViewModel.CompanyName"></label>
                <input name="@nameof(Model.ViewModel.CompanyName)" class="form-control" asp-for="@Model.ViewModel.CompanyName" placeholder="your name / company name" />
            </div>
            <div class="row mb-1">
                <label class="form-label" asp-for="@Model.ViewModel.CompanyEmail"></label>
                <input name="@nameof(Model.ViewModel.CompanyEmail)" class="form-control" asp-for="@Model.ViewModel.CompanyEmail" placeholder="your email / company email" />
            </div>

            <div class="row mb-1">
                <label class="form-label" asp-for="@Model.ViewModel.CompanyPhone"></label>
                <input name="@nameof(Model.ViewModel.CompanyPhone)" class="form-control" asp-for="@Model.ViewModel.CompanyPhone" placeholder="your phone / company phone" />
            </div>
            <div class="row mb-1">
                <label class="form-label" asp-for="@Model.ViewModel.Password"></label>
                <input name="@nameof(Model.ViewModel.Password)" class="form-control" asp-for="@Model.ViewModel.Password" />
            </div>
            <div class="row mb-1">
                <label class="form-label" asp-for="@Model.ViewModel.ConfirmPassword"></label>
                <input name="@nameof(Model.ViewModel.ConfirmPassword)" class="form-control" asp-for="@Model.ViewModel.ConfirmPassword" />
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-primary m-2" href="/Accounts/Login">
                <i class="bi bi-arrow-left"></i>
                <span>Login</span>
            </a>
            <button class="btn btn-primary">Submit</button>
        </div>
    </form>
    <div style="font-size:.8rem">
        &copy;2025 Tsholofelo Nkuna
    </div>
</div>


