<a class="@CssClass position-relative" @onclick="OnClicked" title="@ToolTip" disabled="@IsLoading">
    @if(Icon is not null){
        @Icon
    }
    @if(!string.IsNullOrWhiteSpace(Text)){
       // &nbsp;
        <span class="ms-1">@Text</span>
    }
   @if(IsLoading){
     <div class="spinner-border spinner-border-sm position-absolute" style="font-size:0.5rem;left:35%;top:35%;"></div>
   }
</a>
