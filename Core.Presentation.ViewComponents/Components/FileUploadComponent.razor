@using Microsoft.AspNetCore.Components.Forms
@namespace Core.Presentation.ViewComponents.Components

<div class="file-upload-container @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@FileInputId" class="form-label">@Label</label>
    }

    <InputFile id="@FileInputId" 
               OnChange="OnFileInputChanged" 
               accept="@AcceptedFileTypes"
               multiple="@AllowMultiple"
               disabled="@IsDisabled"
               class="form-control" />

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mt-2 mb-0" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success mt-2 mb-0" role="alert">
            <i class="bi bi-check-circle"></i> @SuccessMessage
        </div>
    }

    @if (UploadedFiles.Count > 0)
    {
        <div class="mt-3">
            <h6>Uploaded File(s): <span class="badge bg-primary">@UploadedFiles.Count</span></h6>
            <ul class="list-group">
                @foreach (var file in UploadedFiles)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-file-earmark"></i> @file.FileName
                            <small class="text-muted d-block">Size: @FormatFileSize(file.FileSize)</small>
                        </span>
                        <button type="button" 
                                class="btn btn-sm btn-outline-danger"
                                @onclick="async () => await RemoveFile(file)"
                                title="Remove file">
                            <i class="bi bi-trash"></i>
                        </button>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
