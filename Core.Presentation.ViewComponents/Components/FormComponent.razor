@using Core.Presentation.Models
@using Core.Presentation.Models.DataTransferObjects.Base
@using  Core.Presentation.Models.Base
@using Core.Presentation.Models.Validation
@using Core.Presentation.ViewComponents.Components.Base
@using Microsoft.AspNetCore.Components.Forms
@using Core.Presentation.ViewComponents.Components.Templates;
@typeparam TRecord where TRecord: BaseDto, new()
@inherits GenericComponentBase<FormComponentViewModel<TRecord>, TRecord> 

@foreach(var sourceRecord in this.ViewModel.ViewModelState)
{

    <div class="card">
        <div class="card-header" @onclick="()=>{ViewModel.Collapse = !ViewModel.Collapse;}" style="cursor:pointer">
            <div class="d-flex justify-content-between">
                <h6 class="text-primary">@ViewModel.Title</h6>
                <div>
                    <i class="bi bi-chevron-@(ViewModel.Collapse ? "down":"up")"></i>
                </div>
            </div>
        </div>
        <form class="card-body @(ViewModel.Collapse ? "d-none":"")"  id="@ViewModel.FormName" method="post">

            @{

                if (ViewModel.IncludeFormStatePropsAsHidden)
                {
                    foreach (var formStateKeyVal in this.RecordAsKeyValuePairs(sourceRecord).Where(kv => !ViewModel.Fields.Any(field => kv.Key == field.Name)))
                    {

                        <input type="hidden" name="@formStateKeyVal.Key" value="@formStateKeyVal.Value" />
                    }
                }
            }
            <div class="row gx-5 gy-3">
                @foreach (var field in ViewModel.Fields)
                {
                    <div class="@ViewModel.ColClass">
                        <InputComponent 
                            ViewModel="field"
                            OnValidationFail="OnValidationFail"
                            ViewModelState="sourceRecord"> 

                        </InputComponent>
                    </div>
                }
            </div>
          
        </form>
        @if (!ViewModel.CollapseFooter)
        {
            <div class="card-footer  @(ViewModel.Collapse ? "d-none":"")">
                <ButtonTemplate 
                    Text="@ViewModel.SubmitButtonText"
                    OnClick="OnFormSubmit"
                    CssClass="btn btn-primary"
                    IsLoading="SubmitBusy">
                </ButtonTemplate>
               
               @*  <button type="reset" class="btn btn-secondary">Reset</button> *@
            </div>
        }
    </div>
    <script>

    </script>
}