@using ClientManagement.Models
@using ClientManagement.Models.DataTransferObjects.Base
@using ClientManagement.Models.Validation
@typeparam TRecord where TRecord : BaseDto, new()

@switch (ViewModel.ControlType)
{

    case ControlType.Text:
    case ControlType.Email:

        <div class="row">
            <div class="col-12"><label class="form-label">@ViewModel.Label</label></div>
            <div class="col-12">

                <input class="form-control @(!string.IsNullOrWhiteSpace(ViewModel.ValidationMessage) ? "border-danger": string.Empty)"
                name="@ViewModel.Name"
                value="@(_genericListViewModel.Get<string>(ViewModelState.Id, ViewModel.Name))"
                @onchange="(eventArgs) => { this.OnInputChange(ViewModelState.Id, ViewModel, eventArgs.Value);}" />
                @if(ViewModel.Validator?.Validators?.Any( x => x.Name == nameof(Validators.Number)) ?? false){
                    <div class="text-secondary mt-1" style="font-size:0.63rem">e.g. 9,99</div>
                }
                    @if (!string.IsNullOrWhiteSpace(ViewModel.ValidationMessage))
                {
                    <div class="text-danger">@ViewModel.ValidationMessage</div>
                }
            </div>
        </div>

        break;
    case ControlType.Checkbox:

        <div class="row">
            <div class="col-12"><label class="form-label">@ViewModel.Label</label></div>
            @if ((_genericListViewModel.Get<bool>(ViewModelState.Id, ViewModel.Name)))
            {
                <div class="col-auto"> <input @oninput="(e) => { this._genericListViewModel.Set(ViewModelState.Id, ViewModel.Name, e.Value); }" checked type="checkbox" class="form-check-input" name="@ViewModel.Name" value="@bool.TrueString" /></div>
            }
            else
            {

                <div class="col-auto"> <input @oninput="(e) => { this._genericListViewModel.Set(ViewModelState.Id, ViewModel.Name, e.Value); }" type="checkbox" class=" form-check-input" name="@ViewModel.Name" value="@bool.TrueString" /></div>
            }

        </div>
        break;
    case ControlType.Select:
        <div class="row">
            <div class="col-12"><label class="form-label">@ViewModel.Label</label></div>
            <div class="col-12">
                <select class="form-select @(!string.IsNullOrWhiteSpace(ViewModel.ValidationMessage) ? "border-danger":"")"
                        value="@(_genericListViewModel.Get<string>(ViewModelState.Id, ViewModel.Name))"
                        @onchange="(e) => _genericListViewModel.Set(ViewModelState.Id, ViewModel.Name, e.Value)">
                    <option value="">Please select</option>
                    @foreach (var option in ViewModel.Options)
                    {
                        <option value="@option.Key">@option.Value</option>
                    }
                </select>
                @if (!string.IsNullOrWhiteSpace(ViewModel.ValidationMessage))
                {
                    <div class="text-danger">@ViewModel.ValidationMessage</div>
                }
            </div>
        </div>
        break;
    case ControlType.Date:
        <div class="row">
            <div class="col-12"><label class="form-label">@ViewModel.Label</label></div>
            <div class="col-12">
                <input class="form-control  @(!string.IsNullOrWhiteSpace(ViewModel.ValidationMessage) ? "border-danger": string.Empty)"
                       name="@ViewModel.Name"
                       value="@(_genericListViewModel.Get<string>(ViewModelState.Id, ViewModel.Name, true))"
                       placeholder="dd/MM/yyyy"
                       @onchange="(eventArgs) => { this.OnInputChange(ViewModelState.Id, ViewModel, eventArgs.Value);}" />
                <div class="text-secondary mt-1" style="font-size:0.63rem">dd/MM/yyyy</div>
                       @if (!string.IsNullOrWhiteSpace(ViewModel.ValidationMessage))
                        {
                            <div class="text-danger">@ViewModel.ValidationMessage</div>
                        }
            </div>
        </div>
        break;
    case ControlType.MultiSelect:
        <div class="row">
            <div class="col-12">
                <label class="form-label">@ViewModel.Label</label>
            </div>
            <div class="col-12">
                <div class="row" style="width:256px;">
                    <div class="col-12 py-3 ms-3 rounded @(!string.IsNullOrWhiteSpace(ViewModel.ValidationMessage)?"border-danger":string.Empty)" style="border:1px dotted gray;cursor:pointer" @onclick="()=> {ViewModel.SearchBoxOptionsVisible=true;}">
                        @if (_genericListViewModel.Get<IEnumerable<string>?>(ViewModelState.Id, ViewModel.Name) is IEnumerable<string> multiSelectOptions)
                        {
                            @foreach (var mulitSelectOptionKey in multiSelectOptions)
                            {
                                var optionVal = ViewModel.Options.Any() ? ViewModel.Options.FirstOrDefault(op => op.Key == mulitSelectOptionKey).Value : null;
                                if (optionVal is not null)
                                {
                                    <span class="badge bg-primary"> <span style="width:128px;display:inline-block;text-overflow:ellipsis;white-space:nowrap;overflow:hidden">@optionVal</span></span>
                                }
                            }
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ViewModel.ValidationMessage))
                    {
                        <div class="text-danger">@ViewModel.ValidationMessage</div>
                    }
                    <div class="col-12 position-relative">

                        <ul style="max-height:256px;height:auto; overflow-y:auto;" class="list-group position-absolute top-0 @(!ViewModel.SearchBoxOptionsVisible?"d-none":string.Empty) z-2">
                            <li class="list-group-item position-sticky top-0">
                                <div class="d-flex flex-row-reverse"><a @onclick="(e) =>{ViewModel.SearchBoxOptionsVisible = false;}" class="btn btn-close"></a></div>
                            </li>
                            @foreach (var item in ViewModel.Options)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <span>@item.Value</span>
                                        <input @oninput="(e) => OnMultiSelectInputChange(ViewModelState.Id, ViewModel, e.Value, item)"
                                               value="@item.Key"
                                               type="checkbox"
                                               class="form-check-input" />
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        break;
}